<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PrestarConta">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPrestarConta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#EEA09898"
        app:title="Prestação de Contas"
        app:titleTextColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/layoutCards"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/toolbarPrestarConta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Total Recebido -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#F1EEEE"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Recebido"
                    android:fontFamily="@font/questrial"
                    android:textSize="12sp"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/txtRecebido"
                    android:fontFamily="@font/questrial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="R$ 0,00"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000000"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Total Gasto -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#F1EEEE"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Gasto"
                    android:fontFamily="@font/questrial"
                    android:textSize="12sp"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/txtGasto"
                    android:fontFamily="@font/questrial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="R$ 0,00"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000000"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Saldo Atual -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#F1EEEE"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saldo Atual"
                    android:fontFamily="@font/questrial"
                    android:textSize="12sp"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/txtSaldo"
                    android:fontFamily="@font/questrial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="R$ 0,00"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#2E7D32"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPrestContas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutCards"
        app:layout_constraintBottom_toTopOf="@id/btnAdicionar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnAdicionar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#EEA09898"
        android:text="Adicionar lançamento"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>